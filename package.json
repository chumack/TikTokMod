{
  "name": "tiktok-mod",
  "version": "0.3.3",
  "description": "TikTok desktop client: browse, download without watermark, proxy/region support",
  "main": "src/main/main.js",
  "author": {
    "name": "chumack",
    "email": "chumack@users.noreply.github.com"
  },
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "postinstall": "node scripts/postinstall.js",
    "icon": "node scripts/make-icon.js",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux",
    "dist:linux:appimage": "electron-builder --linux AppImage",
    "dist:linux:deb": "electron-builder --linux deb"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.tiktokmod.app",
    "productName": "TikTokMod",
    "beforePack": "scripts/before-pack.js",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "scripts/**/*",
      "package.json",
      "!**/*.map"
    ],
    "extraResources": [
      {
        "from": "vendor",
        "to": "vendor",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": true,
      "artifactName": "TikTokMod-Setup-${version}-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "TikTokMod-Portable-${version}-${arch}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "tar.gz"
      ],
      "icon": "build/icon.png",
      "category": "AudioVideo",
      "synopsis": "TikTok desktop client",
      "maintainer": "chumack <chumack@users.noreply.github.com>",
      "desktop": {
        "StartupWMClass": "TikTokMod"
      }
    }
  },
  "allowScripts": {
    "electron": true
  }
}
